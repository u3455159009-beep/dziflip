generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support in Prisma; statuses are validated in TS (see src/lib/types.ts)
// ProjectStatus: ACTIVE | WATCHED | BOUGHT | RENOVATING | SOLD | REJECTED
// PriceType: ASKING | ESTIMATE | REALIZED
// DataConfidence: VERIFIED | ESTIMATED | UNKNOWN
// PriceSource: EXACT | ESTIMATE | MANUAL
// ContactStatus: NEKONTAKTOVANO | ZPRAVA_PRIPRAVENA | ODESLANO | ODPOVEDEL | PROHLIDKA | JEDNANI | ODMITNUTO
// ContactAutomationMode: OFF | DRAFT | AUTO
// OutreachStatus: DRAFT | SENT | BLOCKED_NO_PROVIDER | BLOCKED_RULES | FAILED | RECEIVED
// NotificationChannel: IN_APP | EMAIL | PUSH | SMS
// NotificationStatus: SENT | NOT_CONFIGURED | FAILED | QUEUED
// SourceProviderStatus: ACTIVE | PENDING_ACCESS
// SmsDirection: OUTBOUND | INBOUND
// SmsKind: INTRO | REPLY
// SmsStatus: DRAFT | QUEUED | SENT | DELIVERED | FAILED | RECEIVED
// SmsProviderKey: MOCK_SMS | REAL_SMS
// SmsClassification: NABIZI_PROHLIDKU | CHCE_ZAVOLAT | NEMOVITOST_PRODANA | NEMA_ZAJEM | CHCE_DALSI_INFORMACE | JINE | UNKNOWN
// SmsAutomationMode: OFF | DRAFT | AUTO
// MessageTemplateChannel: EMAIL | SMS

model Project {
  id        String   @id @default(cuid())
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Source
  sourceUrl  String?
  sourceText String?
  portal     String?

  // Extracted listing fields
  title             String?
  askingPrice       Float?
  disposition       String?
  areaM2            Float?
  pricePerM2        Float?
  municipality      String?
  district          String?
  street            String?
  floor             String?
  totalFloors       String?
  buildingType      String?
  construction      String?
  ownership         String?
  condition         String?
  buildingCondition String?
  penb              String?
  balcony           Boolean?
  terrace           Boolean?
  loggia            Boolean?
  cellar            Boolean?
  parking           Boolean?
  elevator          Boolean?
  orientation       String?
  legalNotes        String?
  fullText          String?

  // JSON map of fieldName -> DataConfidence, stored as string
  fieldMeta String?

  // My own targets
  targetPrice Float?

  // Deal Radar / dedup
  externalId      String? // stable id from a source provider, used for dedup
  isDemo          Boolean  @default(false) // true when created from the MOCK_DEMO provider — never real data
  sourceWatcherId String?
  sourceWatcher   Watcher? @relation(fields: [sourceWatcherId], references: [id], onDelete: SetNull)

  photos           Photo[]
  comparables      Comparable[]
  budgetItems      BudgetItem[]
  assumptions      Assumptions?
  priceHistory     PriceHistory[]
  contact          Contact?
  outreachMessages OutreachMessage[]
  alerts           Alert[]
  smsMessages      SmsMessage[]
  smsAuditLogs     SmsAuditLog[]

  @@unique([portal, externalId])
}

model PriceHistory {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  price      Float
  recordedAt DateTime @default(now())
  source     String   @default("MANUAL") // MANUAL | WATCHER | SEED
}

model Contact {
  id              String    @id @default(cuid())
  projectId       String    @unique
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String?
  phone           String?
  email           String?
  agency          String?
  lastContactedAt DateTime?
  status          String    @default("NEKONTAKTOVANO")
  updatedAt       DateTime  @updatedAt

  smsMessages SmsMessage[]
}

model OutreachMessage {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  direction     String // OUTBOUND | INBOUND
  mode          String? // DRAFT | AUTO — for outbound messages only
  channel       String    @default("EMAIL")
  subject       String?
  body          String
  status        String // DRAFT | SENT | BLOCKED_NO_PROVIDER | BLOCKED_RULES | FAILED | RECEIVED
  blockedReason String?
  createdAt     DateTime  @default(now())
  sentAt        DateTime?
}

model MessageTemplate {
  id        String   @id @default(cuid())
  name      String
  body      String
  channel   String   @default("EMAIL") // EMAIL | SMS
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Watcher {
  id     String  @id @default(cuid())
  name   String
  active Boolean @default(true)

  municipality   String?
  district       String?
  dispositions   String? // comma-separated, e.g. "2+1,2+kk"
  minAreaM2      Float?
  maxAreaM2      Float?
  maxAskingPrice Float?
  maxPricePerM2  Float?
  condition      String?
  ownership      String? // OSOBNI | DRUZSTEVNI | null = any

  minProfit             Float?
  minRoiPct             Float?
  maxRenovationEstimate Float?
  requiredReserve       Float?

  onlyNewListings   Boolean @default(false)
  trackPriceChanges Boolean @default(true)

  sources String @default("MOCK_DEMO") // comma-separated provider keys

  lastRunAt   DateTime?
  lastRunNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]
  alerts   Alert[]
}

model Alert {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  watcherId String?
  watcher   Watcher? @relation(fields: [watcherId], references: [id], onDelete: SetNull)

  reason         String // NEW_MATCH | PRICE_DROP
  band           String?
  askingPrice    Float?
  pricePerM2     Float?
  expectedProfit Float?
  roiPct         Float?

  createdAt DateTime  @default(now())
  readAt    DateTime?

  notifications NotificationLog[]
}

model NotificationLog {
  id        String   @id @default(cuid())
  alertId   String?
  alert     Alert?   @relation(fields: [alertId], references: [id], onDelete: Cascade)
  channel   String // IN_APP | EMAIL | PUSH | SMS
  status    String // SENT | NOT_CONFIGURED | FAILED | QUEUED
  detail    String?
  createdAt DateTime @default(now())
}

model Settings {
  id String @id @default("singleton")

  defaultMinProfit           Float?
  defaultMinRoiPct           Float?
  defaultReserve             Float?
  defaultRenovationCostPerM2 Float?
  preferredLocalities        String? // JSON array of strings

  notifyInApp        Boolean @default(true)
  notifyEmail        Boolean @default(false)
  notifyEmailAddress String?

  contactAutomationMode        String    @default("DRAFT") // OFF | DRAFT | AUTO
  contactAutomationConfirmedAt DateTime?
  dailyContactLimit            Int       @default(5)
  defaultTemplateId            String?

  smsAutomationMode        String    @default("DRAFT") // OFF | DRAFT | AUTO
  smsAutomationConfirmedAt DateTime?
  maxAutoSmsPerDay         Int       @default(3)
  smsAutoReplyEnabled      Boolean   @default(false)
  defaultSmsTemplateId     String?

  updatedAt DateTime @updatedAt
}

model SmsMessage {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  direction String // OUTBOUND | INBOUND
  kind      String  @default("INTRO") // INTRO | REPLY
  mode      String? // DRAFT | AUTO — outbound only
  phone     String // counterparty's phone number (normalized)
  body      String
  status    String // DRAFT | QUEUED | SENT | DELIVERED | FAILED | RECEIVED
  provider  String  @default("MOCK_SMS") // MOCK_SMS | REAL_SMS
  isDemo    Boolean @default(false)

  providerMessageId String?
  blockedReason     String?

  classification       String? // inbound only — UNKNOWN unless a deterministic rule matched
  suggestedDateTimeRaw String?
  suggestedDateTime    DateTime?

  readAt DateTime? // inbound: has the user seen it in the inbox

  createdAt   DateTime  @default(now())
  queuedAt    DateTime?
  sentAt      DateTime?
  deliveredAt DateTime?
  failedAt    DateTime?
}

model SmsBlacklist {
  id        String   @id @default(cuid())
  phone     String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

// Full audit trail of every SMS automation decision — including why a
// message was NOT sent — per rule step (Deal Radar check, confidence,
// dedup, daily limit, blacklist, mode).
model SmsAuditLog {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  phone     String?
  step      String
  result    String // PASS | FAIL | INFO
  detail    String?
  createdAt DateTime @default(now())
}

// Self-contained DEMO fixture data used only by the MOCK_DEMO source provider.
// Never presented as real market data — always tagged isDemo/portal "DEMO" downstream.
model DemoListing {
  id           String   @id @default(cuid())
  externalId   String   @unique
  portal       String   @default("DEMO")
  title        String
  municipality String
  district     String?
  disposition  String
  areaM2       Float
  price        Float
  basePrice    Float
  condition    String
  ownership    String
  url          String
  photos       String // JSON array of urls
  publishedAt  DateTime
}

model Photo {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  room      String?
  notes     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Comparable {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String?
  url         String?
  portal      String?
  locality    String?
  disposition String?
  areaM2      Float?
  price       Float?
  pricePerM2  Float?
  condition   String?
  distanceKm  Float?
  priceType   String   @default("ASKING")
  foundAt     DateTime @default(now())
  createdAt   DateTime @default(now())
}

model BudgetItem {
  id               String    @id @default(cuid())
  projectId        String
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  room             String?
  category         String
  name             String
  quantity         Float?
  unit             String?
  unitPrice        Float?
  laborEstimate    Float?
  materialEstimate Float?
  total            Float?
  priceSource      String    @default("ESTIMATE")
  productUrl       String?
  shop             String?
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())
  sortOrder        Int       @default(0)
}

model Assumptions {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  purchasePriceUsed Float? // price used for economics calc (defaults to askingPrice)

  saleConservative Float?
  saleBase         Float?
  saleOptimistic   Float?

  renovationCost Float?
  furnishingCost Float?
  legalCosts     Float?
  financingCost  Float?
  otherCosts     Float?
  reserve        Float?

  minProfit    Float?
  minMarginPct Float? // 0-1
  minRoiPct    Float? // 0-1

  incomeTaxPct Float? // 0-1, optional, default 0

  bandWidthPct Float? // width of NORMAL/BUY-NOW bands around the good threshold, default 0.08

  updatedAt DateTime @updatedAt
}
