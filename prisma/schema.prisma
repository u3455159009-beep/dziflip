generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Single connection string for everything — runtime queries AND schema
  // migrations. Vercel's Prisma Postgres integration provisions exactly
  // one DATABASE_URL (a prisma+postgres:// Accelerate URL) and nothing
  // else; Prisma's tooling runs `migrate deploy`/`db push` directly
  // against it without a separate direct/unpooled connection. If you ever
  // switch to a self-managed Postgres behind a plain pooler (PgBouncer,
  // Supabase, Neon) that does NOT support schema changes through the
  // pooled connection, add a second `directUrl = env("DIRECT_URL")` field
  // back here pointing at that provider's unpooled connection string.
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support in Prisma; statuses are validated in TS (see src/lib/types.ts)
// ProjectStatus: ACTIVE | WATCHED | BOUGHT | RENOVATING | SOLD | REJECTED
// PriceType: ASKING | ESTIMATE | REALIZED
// DataConfidence: VERIFIED | ESTIMATED | UNKNOWN
// PriceSource: EXACT | ESTIMATE | MANUAL
// ContactStatus: NEKONTAKTOVANO | ZPRAVA_PRIPRAVENA | ODESLANO | ODPOVEDEL | PROHLIDKA | JEDNANI | ODMITNUTO
// ContactAutomationMode: OFF | DRAFT | AUTO
// OutreachStatus: DRAFT | SENT | BLOCKED_NO_PROVIDER | BLOCKED_RULES | FAILED | RECEIVED
// NotificationChannel: IN_APP | EMAIL | PUSH | SMS
// NotificationStatus: SENT | NOT_CONFIGURED | FAILED | QUEUED
// SourceProviderStatus: ACTIVE | PENDING_ACCESS
// SmsDirection: OUTBOUND | INBOUND
// SmsKind: INTRO | REPLY
// SmsStatus: DRAFT | QUEUED | SENT | DELIVERED | FAILED | RECEIVED
// SmsProviderKey: MOCK_SMS | REAL_SMS
// SmsClassification: NABIZI_PROHLIDKU | CHCE_ZAVOLAT | NEMOVITOST_PRODANA | NEMA_ZAJEM | CHCE_DALSI_INFORMACE | JINE | UNKNOWN
// SmsAutomationMode: OFF | DRAFT | AUTO
// MessageTemplateChannel: EMAIL | SMS
// AnalysisStage: FOUND | BASIC_ANALYSIS | COMPARABLES | PHOTO_ANALYSIS | FULL_ANALYSIS
// SourceType (computed, not stored): DEMO | MANUAL | REAL
// DuplicateClassification: SAME_PROPERTY | POSSIBLE_DUPLICATE | DIFFERENT
// DuplicateResolvedStatus: PENDING | CONFIRMED_SAME | CONFIRMED_DIFFERENT
// ListingEventType: CAPTURED | PRICE_CHANGE | DESCRIPTION_CHANGE | CONDITION_CHANGE | CONTACT_CHANGE | PHOTOS_CHANGED | STATUS_CHANGE
// CompQualityTier: HIGH | MEDIUM | LOW
// RoomType: KUCHYN | OBYVACI_POKOJ | LOZNICE | KOUPELNA | WC | CHODBA | BALKON | TERASA | EXTERIER | SKLEP | GARAZ | NEZNAME
// RenovationPlan.priceLevel: BUDGET | STANDARD | PREMIUM
// PhotoGeneration.confidence: HIGH | MEDIUM | LOW
// Photo.matchConfidence: EXACT_MATCH | HIGH_CONFIDENCE_MATCH | POSSIBLE_MATCH
// RenovationBudgetStatus: WITHIN_BUDGET | NEAR_LIMIT | OVER_BUDGET | INSUFFICIENT_DATA
// RoomConditionStatus: KEEP | COSMETIC | REPLACE | FULL_RENOVATION | UNKNOWN
// DataSourceKind: MANUAL | AI_VISION | PROVIDER
// PhotoGenerationStatus: NOT_CONFIGURED | PENDING | GENERATED | FAILED
// PhotoGenerationStyle: LEVNY_FLIP | MODERNI | PREMIUM | MINIMALISTICKY | SCANDI | LUXURY | CUSTOM
// ProductRequirementStatus: NEEDED | SELECTED | TO_BUY | ORDERED | BOUGHT | PICKED_UP | INSTALLED
// PropertyType: APARTMENT | HOUSE | LAND | GARAGE | COMMERCIAL | OTHER
// ListingMatchConfidence: EXACT_MATCH | HIGH_CONFIDENCE_MATCH | POSSIBLE_MATCH | NOT_FOUND
// RenovationDataStatus: KNOWN | ESTIMATED | UNKNOWN
// ShoppingCategory: STAVEBNI_MATERIAL | KOUPELNA | KUCHYN | OSVETLENI | NABYTEK | SPOTREBICE | DEKORACE | OSTATNI
// ProductCategory: PODLAHY | LISTY | BARVY | OBKLADY | DLAZBY | LEPIDLA | SPAROVACI_HMOTY | SVETLA | ZASUVKY |
//   VYPINACE | DVERE | KLIKY | SANITA | WC | UMYVADLA | SPRCHY | VANY | VODOVODNI_BATERIE | KUCHYNE |
//   PRACOVNI_DESKY | DREZY | SPOTREBICE | POSTELE | MATRACE | SKRINE | STOLY | ZIDLE | POHOVKY | KRESLA |
//   KONFERENCNI_STOLKY | ZRCADLA | ZAVESY | DEKORACE | OSTATNI
// ProductAvailability: SKLADEM | OMEZENE | NENI_SKLADEM | UNKNOWN
// ProductTier: BUDGET | STANDARD | PREMIUM
// ProductSource: PROVIDER | MANUAL
// ProductStatus: CANDIDATE | UNAVAILABLE

model Project {
  id        String   @id @default(cuid())
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Source
  sourceUrl  String?
  sourceText String?
  portal     String?

  // Extracted listing fields
  title             String?
  askingPrice       Float?
  disposition       String?
  areaM2            Float?
  pricePerM2        Float?
  municipality      String?
  district          String?
  street            String?
  floor             String?
  totalFloors       String?
  buildingType      String?
  construction      String?
  ownership         String?
  condition         String?
  buildingCondition String?
  penb              String?
  balcony           Boolean?
  terrace           Boolean?
  loggia            Boolean?
  cellar            Boolean?
  parking           Boolean?
  elevator          Boolean?
  orientation       String?
  legalNotes        String?
  fullText          String?
  description       String? // cleaned listing description, when separable from fullText
  latitude          Float? // only ever set from real structured source data (e.g. JSON-LD), never guessed
  longitude         Float?

  // Property Type Engine — auto-detected from text, correctable manually.
  // APARTMENT | HOUSE | LAND | GARAGE | COMMERCIAL | OTHER. UI shows only
  // the attribute set relevant to this type (e.g. never "floor"/"elevator"
  // for LAND or GARAGE).
  propertyType String?

  // Extended extraction (item 3) — renovation-history signals, never
  // guessed: each is only ever set from an explicit textual mention.
  airConditioning        Boolean? // klimatizace
  electricalRewiring     Boolean? // nové rozvody elektřiny
  masonryCore            Boolean? // zděné jádro (vs. original panel core)
  windowsReplacedYear    Int? // rok výměny oken
  insulationYear         Int? // rok zateplení
  roofYear               Int? // rok (nové) střechy
  risersYear             Int? // rok výměny stoupaček

  // HOUSE / LAND — building vs. land plot area are tracked separately from
  // the apartment-oriented areaM2 (which for a house means usable floor area).
  landAreaM2 Float?

  // LAND-specific
  zoning            String? // územní plán / využití pozemku
  buildable         Boolean? // zastavitelnost
  utilitiesAvailable String? // sítě (voda/plyn/elektřina/kanalizace) — free text, never inferred
  accessRoad        String? // přístupová komunikace
  structuresOnLand  String? // stavby na pozemku
  landRestrictions  String? // věcná břemena / omezení

  // GARAGE-specific
  garageDimensions    String?
  garageElectricity   Boolean?
  garageLandOwnership String? // vlastnictví pozemku pod garáží
  garageRentNote      String? // poznámka k případnému nájmu pozemku

  // Listing Discovery Engine (item 1) — best-effort match of a pasted
  // text-only listing to its publicly findable original, found only via an
  // ACTIVE search provider. Never claims a match without one.
  discoveredListingUrl        String?
  discoveredListingConfidence String? // EXACT_MATCH | HIGH_CONFIDENCE_MATCH | POSSIBLE_MATCH | NOT_FOUND
  discoveredListingReasons    String? // JSON array of human-readable match reasons

  // Comparable Discovery Engine (item 4) — cache bookkeeping so re-opening a
  // project doesn't re-run provider discovery on every page load.
  lastComparableDiscoveryAt   DateTime?
  comparableDiscoveryNote     String? // e.g. "žádný aktivní zdroj srovnání" — always shown to the user, never silent

  // Listing Discovery Engine — which provider/external id produced the best
  // match above, when it wasn't NOT_FOUND. Provider-agnostic by design (not
  // FlatScan-specific) so any future provider plugs in the same way.
  discoveredListingProvider   String?
  discoveredListingExternalId String?

  // POSSIBLE_MATCH photo staging (items 1/2) — when the Listing Discovery
  // Engine finds only a POSSIBLE_MATCH candidate, its photos are staged here
  // (never copied into real Photo rows) until the user explicitly confirms
  // the candidate really is the same property.
  discoveredListingCandidatePhotos String? // JSON array of candidate photo URLs, staged only
  discoveredListingPhotosConfirmed Boolean @default(false)

  // JSON map of fieldName -> DataConfidence, stored as string
  fieldMeta   String?
  // JSON map of fieldName -> human-readable source label (e.g. "Sreality.cz", "ruční zadání", "AI Vision")
  fieldSource String?

  // My own targets
  targetPrice Float?

  // Real Data Engine timestamps
  publishedAt     DateTime? // when the source portal published the listing, if known
  firstSeenAt     DateTime  @default(now()) // when DziFlip first captured this listing
  lastSeenAt      DateTime  @default(now()) // last time a provider/re-scan confirmed the listing still exists
  sourceUpdatedAt DateTime? // when the source portal says it was last updated, if known
  lastVerifiedAt  DateTime? // last time critical fields (price/area) were reconfirmed against the source

  // Deal Radar / dedup
  externalId      String? // stable id from a source provider, used for dedup
  isDemo          Boolean  @default(false) // true when created from the MOCK_DEMO provider — never real data
  sourceWatcherId String?
  sourceWatcher   Watcher? @relation(fields: [sourceWatcherId], references: [id], onDelete: SetNull)
  analysisStage   String   @default("FULL_ANALYSIS") // FOUND | BASIC_ANALYSIS | COMPARABLES | PHOTO_ANALYSIS | FULL_ANALYSIS

  photos              Photo[]
  comparables         Comparable[]
  budgetItems         BudgetItem[]
  assumptions         Assumptions?
  priceHistory        PriceHistory[]
  contact             Contact?
  outreachMessages    OutreachMessage[]
  alerts              Alert[]
  smsMessages         SmsMessage[]
  smsAuditLogs        SmsAuditLog[]
  listingEvents       ListingEvent[]
  roomConditions      RoomCondition[]
  productRequirements ProductRequirement[]
  duplicatesAsA       PossibleDuplicate[]  @relation("DuplicateA")
  duplicatesAsB       PossibleDuplicate[]  @relation("DuplicateB")
  renovationPlan      RenovationPlan?

  @@unique([portal, externalId])
}

model PriceHistory {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  price      Float
  recordedAt DateTime @default(now())
  source     String   @default("MANUAL") // MANUAL | WATCHER | SEED
}

model Contact {
  id              String    @id @default(cuid())
  projectId       String    @unique
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String?
  phone           String?
  email           String?
  agency          String?
  lastContactedAt DateTime?
  status          String    @default("NEKONTAKTOVANO")
  updatedAt       DateTime  @updatedAt

  smsMessages SmsMessage[]
}

model OutreachMessage {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  direction     String // OUTBOUND | INBOUND
  mode          String? // DRAFT | AUTO — for outbound messages only
  channel       String    @default("EMAIL")
  subject       String?
  body          String
  status        String // DRAFT | SENT | BLOCKED_NO_PROVIDER | BLOCKED_RULES | FAILED | RECEIVED
  blockedReason String?
  createdAt     DateTime  @default(now())
  sentAt        DateTime?
}

model MessageTemplate {
  id        String   @id @default(cuid())
  name      String
  body      String
  channel   String   @default("EMAIL") // EMAIL | SMS
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Watcher {
  id     String  @id @default(cuid())
  name   String
  active Boolean @default(true)

  municipality   String?
  district       String?
  dispositions   String? // comma-separated, e.g. "2+1,2+kk"
  minAreaM2      Float?
  maxAreaM2      Float?
  maxAskingPrice Float?
  maxPricePerM2  Float?
  condition      String?
  ownership      String? // OSOBNI | DRUZSTEVNI | null = any

  minProfit             Float?
  minRoiPct             Float?
  maxRenovationEstimate Float?
  requiredReserve       Float?

  onlyNewListings   Boolean @default(false)
  trackPriceChanges Boolean @default(true)

  sources String @default("MOCK_DEMO") // comma-separated provider keys

  lastRunAt   DateTime?
  lastRunNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]
  alerts   Alert[]
}

model Alert {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  watcherId String?
  watcher   Watcher? @relation(fields: [watcherId], references: [id], onDelete: SetNull)

  reason         String // NEW_MATCH | PRICE_DROP
  band           String?
  askingPrice    Float?
  pricePerM2     Float?
  expectedProfit Float?
  roiPct         Float?

  createdAt DateTime  @default(now())
  readAt    DateTime?

  notifications NotificationLog[]
}

model NotificationLog {
  id        String   @id @default(cuid())
  alertId   String?
  alert     Alert?   @relation(fields: [alertId], references: [id], onDelete: Cascade)
  channel   String // IN_APP | EMAIL | PUSH | SMS
  status    String // SENT | NOT_CONFIGURED | FAILED | QUEUED
  detail    String?
  createdAt DateTime @default(now())
}

model Settings {
  id String @id @default("singleton")

  defaultMinProfit           Float?
  defaultMinRoiPct           Float?
  defaultReserve             Float?
  defaultRenovationCostPerM2 Float?
  preferredLocalities        String? // JSON array of strings

  notifyInApp        Boolean @default(true)
  notifyEmail        Boolean @default(false)
  notifyEmailAddress String?

  contactAutomationMode        String    @default("DRAFT") // OFF | DRAFT | AUTO
  contactAutomationConfirmedAt DateTime?
  dailyContactLimit            Int       @default(5)
  defaultTemplateId            String?

  smsAutomationMode        String    @default("DRAFT") // OFF | DRAFT | AUTO
  smsAutomationConfirmedAt DateTime?
  maxAutoSmsPerDay         Int       @default(3)
  smsAutoReplyEnabled      Boolean   @default(false)
  defaultSmsTemplateId     String?

  // Real Data Engine (Phase 4)
  showDemoData           Boolean @default(true) // false = hide isDemo projects everywhere
  minCompCount           Int     @default(3)
  minCompQuality         String  @default("MEDIUM") // HIGH | MEDIUM | LOW — minimum tier counted toward market value
  maxCompDistanceKm      Float   @default(2)
  maxCompAgeDays         Int     @default(180)
  aiPhotoAnalysisEnabled Boolean @default(false)
  staleDataThresholdDays Int     @default(14)

  // Real Product Shopping & Renovation Engine (Phase 5)
  shoppingReferenceLocality String? // used only to bias product-branch search toward this area; never auto-detected

  // FlatScan Data API integration — cache freshness window. FlatScan's
  // Starter tier allows only 1 000 API calls/month, so search results and
  // individual listings are read-through cached; this controls how long a
  // cached result is served before a fresh API call is made again.
  flatScanCacheTtlHours Int @default(24)

  updatedAt DateTime @updatedAt
}

model SmsMessage {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  direction String // OUTBOUND | INBOUND
  kind      String  @default("INTRO") // INTRO | REPLY
  mode      String? // DRAFT | AUTO — outbound only
  phone     String // counterparty's phone number (normalized)
  body      String
  status    String // DRAFT | QUEUED | SENT | DELIVERED | FAILED | RECEIVED
  provider  String  @default("MOCK_SMS") // MOCK_SMS | REAL_SMS
  isDemo    Boolean @default(false)

  providerMessageId String?
  blockedReason     String?

  classification       String? // inbound only — UNKNOWN unless a deterministic rule matched
  suggestedDateTimeRaw String?
  suggestedDateTime    DateTime?

  readAt DateTime? // inbound: has the user seen it in the inbox

  createdAt   DateTime  @default(now())
  queuedAt    DateTime?
  sentAt      DateTime?
  deliveredAt DateTime?
  failedAt    DateTime?
}

model SmsBlacklist {
  id        String   @id @default(cuid())
  phone     String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

// Full audit trail of every SMS automation decision — including why a
// message was NOT sent — per rule step (Deal Radar check, confidence,
// dedup, daily limit, blacklist, mode).
model SmsAuditLog {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  phone     String?
  step      String
  result    String // PASS | FAIL | INFO
  detail    String?
  createdAt DateTime @default(now())
}

// Self-contained DEMO fixture data used only by the MOCK_DEMO source provider.
// Never presented as real market data — always tagged isDemo/portal "DEMO" downstream.
model DemoListing {
  id           String   @id @default(cuid())
  externalId   String   @unique
  portal       String   @default("DEMO")
  title        String
  municipality String
  district     String?
  disposition  String
  areaM2       Float
  price        Float
  basePrice    Float
  condition    String
  ownership    String
  url          String
  photos       String // JSON array of urls
  publishedAt  DateTime
}

model Photo {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  room      String?
  notes     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  // Provenance (item 1/2, Listing Photo Discovery) — set when this photo
  // was copied from a specific matched listing via a real provider/direct-
  // URL fetch ("WEB_SEARCH", "DIRECT_URL", a matched listing provider key)
  // or was uploaded by the user directly ("MANUAL_UPLOAD"). Null only for
  // the legacy manual-URL-paste path (POST .../photos with a raw url).
  sourcePhotoProvider     String? // e.g. "WEB_SEARCH", "DIRECT_URL", "MANUAL_UPLOAD"
  sourceListingProvider   String? // matched-listing provider key, e.g. "FLATSCAN" — from Listing Discovery, may differ from sourcePhotoProvider
  sourceListingExternalId String? // matched listing's external id, when known
  sourceListingUrl        String? // the exact listing URL this photo was copied from
  matchConfidence         String? // EXACT_MATCH | HIGH_CONFIDENCE_MATCH | POSSIBLE_MATCH — confidence of the listing match at copy time
  retrievedAt              DateTime? // when this photo URL was actually fetched/copied/uploaded — null for the legacy manual-URL-paste path

  // Real Photo Upload (Vercel Blob storage) — set only for a file the user
  // actually uploaded through the file picker, never guessed.
  mimeType      String? // validated MIME type at upload time, e.g. "image/jpeg"
  fileSizeBytes Int? // real uploaded file size in bytes

  // AI Photo Analysis (Vision provider architecture) — fillable manually
  // today, by a real Vision provider later; analysisSource always says which.
  roomType              String? // KUCHYN | OBYVACI_POKOJ | LOZNICE | KOUPELNA | WC | CHODBA | BALKON | TERASA | EXTERIER | SKLEP | GARAZ | NEZNAME
  currentCondition      String?
  visibleIssues         String? // JSON array of strings
  keepNotes             String?
  removeNotes           String?
  replaceNotes          String?
  renovationSuggestions String?
  analysisConfidence    String? // HIGH | MEDIUM | LOW | UNKNOWN
  analysisSource        String    @default("MANUAL") // MANUAL | AI_VISION
  analyzedAt            DateTime?

  // Structured per-element description (item 3) — JSON object with keys
  // floor/walls/ceiling/doors/windows/lighting/radiators/kitchen/
  // bathroomFixtures/furniture/builtIns, each a short string or null when
  // not determinable from the photo. Only ever populated by a real Vision
  // provider analysis — never invented.
  elementDetails String?

  generations PhotoGeneration[]
}

model PhotoGeneration {
  id           String    @id @default(cuid())
  photoId      String
  photo        Photo     @relation(fields: [photoId], references: [id], onDelete: Cascade)
  style        String // LEVNY_FLIP | MODERNI | PREMIUM | MINIMALISTICKY | SCANDI | LUXURY | CUSTOM
  prompt       String?
  generatedUrl String? // for Gemini: a data: URI (image/png|jpeg;base64,...) — no external object storage is wired up yet
  model        String?
  status       String    @default("NOT_CONFIGURED") // NOT_CONFIGURED | PENDING | GENERATED | FAILED
  createdAt    DateTime  @default(now())
  generatedAt  DateTime?

  // Vendor-provider audit trail (item 14) — never the API key, only which
  // provider/model produced this result and a signature for cache/replay
  // auditing. provider is null for pre-Gemini rows and NOT_CONFIGURED ones.
  provider         String? // provider key, e.g. "GEMINI"
  requestSignature String? // sha256 of (photoUrl, style, prompt, renovationPlan fields, model) — idempotency cache key (item 13)
  // Sanitized, human-readable reason when status=FAILED (safety rejection,
  // no image returned, timeout, rate limited, malformed response, auth
  // error, ...) — always safe to show the user, never contains the API key.
  failureReason    String?

  // Renovation Visualization (items 4/6/8/18) — links this generation to the
  // project's shared design system so all rooms stay visually consistent.
  renovationPlanId String?
  renovationPlan   RenovationPlan? @relation(fields: [renovationPlanId], references: [id], onDelete: SetNull)

  // Change Detection (item 8) — JSON array of changed-item labels, e.g.
  // ["podlaha", "obklady", "svetla"], derived from the same plan that
  // generated the visualization. Never invented independently of the plan.
  changeDetection String?

  // Structural-change disclosure (item 6/18) — set true only when the
  // renovation plan behind this visualization assumes a structural change
  // (e.g. removing a wall) for this room; structuralChangeNote carries the
  // human-readable Czech warning shown in the UI.
  structuralChange     Boolean @default(false)
  structuralChangeNote String?
  requiresTechnicalReview Boolean @default(false) // item 18 — "Vyžaduje technické ověření"

  // Estimated cost to realize this room's visualized changes (item 7),
  // summed from linked ProductRequirement/BudgetItem lines — null until
  // those are linked and priced.
  estimatedRoomCost Float?

  confidence String? // HIGH | MEDIUM | LOW — how faithfully the visualization preserves the original photo's geometry
}

// Shared Renovation Design System (item 4) — exactly one per project, so
// every room's visualization draws from the same flooring/colors/fixtures
// instead of independently invented styles. Fields are free text describing
// the chosen product/style per element; left null until the user (or a
// value-engineering step) sets them.
model RenovationPlan {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  style      String? // e.g. "moderní minimalismus", "skandinávský styl"
  priceLevel String? // BUDGET | STANDARD | PREMIUM — overall target price tier

  flooring        String?
  wallColor       String?
  doors           String?
  handles         String?
  outletsSwitches String?
  lighting        String?
  kitchen         String?
  bathroomFixtures String?
  tiles           String?
  sanitary        String?
  builtIns        String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  generations PhotoGeneration[]
}

model Comparable {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String?
  url         String?
  portal      String?
  locality    String?
  disposition String?
  areaM2      Float?
  price       Float?
  pricePerM2  Float?
  condition   String?
  distanceKm  Float?
  priceType   String   @default("ASKING")
  foundAt     DateTime @default(now())
  createdAt   DateTime @default(now())

  // Comparable Engine V2 — additional fields used for similarity scoring
  ownership    String?
  floor        String?
  totalFloors  String?
  elevator     Boolean?
  balcony      Boolean?
  terrace      Boolean?
  loggia       Boolean?
  parking      Boolean?
  buildingType String?
  construction String?

  similarityScore     Float? // 0-1, cached — see src/lib/comparableEngine.ts for the formula
  similarityBreakdown String? // JSON: { locality, area, disposition, condition, ... } each 0-1
  qualityTier         String? // HIGH | MEDIUM | LOW

  // Comparable Discovery Engine cache/history (item 15) — a manually-added
  // comparable simply has sourceProvider null and lastSeenAt == foundAt.
  sourceProvider String? // provider key that found it, e.g. "SREALITY" — null for manual entries
  lastSeenAt     DateTime @default(now()) // last discovery run that re-confirmed this listing still exists at this price
  isOutlier      Boolean  @default(false) // excluded from Market Value stats by IQR outlier detection (item 7)
  outlierReason  String?

  // Provider's own id for this listing (e.g. FlatScan's numeric id) — links
  // back to a provider-specific cache/price-history for richer detail
  // (days on market, discount %, coordinates) without re-fetching.
  externalId      String?
  daysOnMarket    Int?
  discountPercent Float?
  latitude        Float?
  longitude       Float?

  priceHistory ComparablePriceHistory[]

  @@unique([projectId, url])
}

// Comparable price-drop tracking (item 15) — a row is only ever added when a
// later discovery run re-finds the same URL at a different price.
model ComparablePriceHistory {
  id           String     @id @default(cuid())
  comparableId String
  comparable   Comparable @relation(fields: [comparableId], references: [id], onDelete: Cascade)
  price        Float?
  recordedAt   DateTime   @default(now())
}

model BudgetItem {
  id               String    @id @default(cuid())
  projectId        String
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  room             String?
  category         String
  name             String
  quantity         Float?
  unit             String?
  unitPrice        Float?
  laborEstimate    Float?
  materialEstimate Float?
  // Cost breakdown additions (item 11) — additive-only, so existing budget
  // lines are unaffected. Combined with materialEstimate/laborEstimate and
  // productRequirementId presence to derive the MATERIAL/PRODUCT/LABOUR/
  // DELIVERY/WASTE breakdown at aggregation time (see renovationBudget.ts).
  deliveryEstimate Float? // ESTIMATED — doprava/dovoz, only when a credible methodology set it
  wasteEstimate    Float? // ESTIMATED — prořez/odpad, only when a credible methodology set it
  total            Float?
  priceSource      String    @default("ESTIMATE")
  productUrl       String?
  shop             String?
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())
  sortOrder        Int       @default(0)

  // Phase 5 — set only when this line was generated from selecting a real
  // shopping-list product; a manually-added budget line never has this set.
  productRequirementId String?             @unique
  productRequirement   ProductRequirement? @relation(fields: [productRequirementId], references: [id], onDelete: SetNull)
}

// Generalized listing history beyond price (Real Data Engine, item 4).
model ListingEvent {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  eventType  String // CAPTURED | PRICE_CHANGE | DESCRIPTION_CHANGE | CONDITION_CHANGE | CONTACT_CHANGE | PHOTOS_CHANGED | STATUS_CHANGE
  detail     String?
  oldValue   String?
  newValue   String?
  occurredAt DateTime @default(now())
}

// Duplicate detection between two projects — never auto-merged.
model PossibleDuplicate {
  id             String    @id @default(cuid())
  projectAId     String
  projectA       Project   @relation("DuplicateA", fields: [projectAId], references: [id], onDelete: Cascade)
  projectBId     String
  projectB       Project   @relation("DuplicateB", fields: [projectBId], references: [id], onDelete: Cascade)
  matchScore     Float // 0-1
  classification String // SAME_PROPERTY | POSSIBLE_DUPLICATE | DIFFERENT
  reasons        String // JSON array of human-readable match reasons
  resolvedStatus String    @default("PENDING") // PENDING | CONFIRMED_SAME | CONFIRMED_DIFFERENT
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  @@unique([projectAId, projectBId])
}

// Renovation Condition Score — structured per-room-element assessment,
// manually entered today, AI-fillable later (source distinguishes them).
model RoomCondition {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  room      String
  element   String // podlaha | steny | strop | elektro | svetla | dvere | okna | kuchyn | koupelna | sanita | nabytek
  status    String   @default("UNKNOWN") // KEEP | COSMETIC | REPLACE | FULL_RENOVATION | UNKNOWN
  notes     String?
  source    String   @default("MANUAL") // MANUAL | AI_VISION
  updatedAt DateTime @updatedAt

  @@unique([projectId, room, element])
}

// Real Product Shopping & Renovation Engine (Phase 5). A ProductRequirement
// is the need ("70 m² vinylové podlahy, světlý dub, do 500 Kč/m²"); Product
// rows under it are real candidates found by a provider (or added
// manually) — never fabricated. Exactly one candidate may be isSelected;
// selecting one is the only thing that writes a real price into the
// project's budget/economics (see BudgetItem.productRequirementId).
model ProductRequirement {
  id               String   @id @default(cuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  room             String?
  category         String // one of PRODUCT_CATEGORIES (PODLAHY, OBKLADY, SANITA, ...)
  shoppingCategory String   @default("OSTATNI") // STAVEBNI_MATERIAL | KOUPELNA | KUCHYN | OSVETLENI | NABYTEK | SPOTREBICE | DEKORACE | OSTATNI — top-level /shopping grouping
  description      String
  budgetMin        Float?
  budgetMax        Float?
  dimensions       String?
  style            String?
  quantity         Int      @default(1) // simple unit count (e.g. "1 vana") when not area/length-based
  quantityNeeded   Float? // verified base quantity in `quantityUnit` (e.g. 64 m²) — only ever set from a real, known dimension, never invented
  quantityUnit     String? // m2, bm, ks...
  reservePct       Float    @default(0.1) // waste/reserve buffer applied on top of quantityNeeded
  status           String   @default("NEEDED") // NEEDED | SELECTED | TO_BUY | ORDERED | BOUGHT | PICKED_UP | INSTALLED
  createdAt        DateTime @default(now())

  // Visualization linkage (item 15) — set only when this requirement was
  // generated/derived from a specific AI renovation visualization's change
  // detection, so the shopping list stays tied to what was actually shown.
  sourcePhotoGenerationId String?
  usedInVisualization     Boolean @default(false) // true = "Použito ve vizualizaci"; false but linked = "nejbližší dostupný ekvivalent"

  products   Product[]
  budgetItem BudgetItem?
}

model Product {
  id                   String             @id @default(cuid())
  productRequirementId String
  productRequirement   ProductRequirement @relation(fields: [productRequirementId], references: [id], onDelete: Cascade)

  externalId String? // provider's own product id
  provider   String // provider key, or "MANUAL"
  source     String  @default("PROVIDER") // PROVIDER | MANUAL

  name        String
  brand       String?
  category    String // PRODUCT_CATEGORIES
  description String?
  imageUrl    String?
  productUrl  String? // must point at the specific product, never a homepage
  retailer    String?

  price         Float?
  originalPrice Float?
  unitPrice     Float?
  unit          String? // m2, ks, bm...
  packSize      Float? // e.g. 2.2 (m² per balení) — null when sold as single units
  packUnit      String? // "balení"

  availability String  @default("UNKNOWN") // SKLADEM | OMEZENE | NENI_SKLADEM | UNKNOWN
  tier         String? // BUDGET | STANDARD | PREMIUM

  confidence String  @default("UNKNOWN") // VERIFIED | ESTIMATED | UNKNOWN — never claims VERIFIED without a real, just-checked source
  status     String  @default("CANDIDATE") // CANDIDATE | UNAVAILABLE
  isSelected Boolean @default(false)

  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())

  branches     ProductBranch[]
  priceHistory ProductPriceHistory[]
}

// Per-branch stock, populated only when a provider's source data genuinely
// carries it — quantities are never estimated or guessed.
model ProductBranch {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name           String
  address        String?
  stockStatus    String   @default("UNKNOWN") // SKLADEM | OMEZENE | NENI_SKLADEM | UNKNOWN
  stockQty       Int? // only when the source truly reports a count
  personalPickup Boolean  @default(false)
  updatedAt      DateTime @default(now())
}

model ProductPriceHistory {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price        Float?
  availability String?
  recordedAt   DateTime @default(now())
}

// Provider/pipeline error isolation (item 22) — one bad listing or provider
// must never take down the whole Deal Radar run.
model ProviderErrorLog {
  id           String   @id @default(cuid())
  provider     String
  watcherId    String?
  externalId   String?
  errorMessage String
  retryStatus  String   @default("NONE") // NONE | RETRIED | GAVE_UP
  occurredAt   DateTime @default(now())
}

model Assumptions {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  purchasePriceUsed Float? // price used for economics calc (defaults to askingPrice)

  saleConservative Float?
  saleBase         Float?
  saleOptimistic   Float?

  renovationCost Float?
  furnishingCost Float?
  legalCosts     Float?
  financingCost  Float?
  otherCosts     Float?
  reserve        Float?

  minProfit    Float?
  minMarginPct Float? // 0-1
  minRoiPct    Float? // 0-1

  // Budget First (item 5) — manual override for MAX RENOVATION BUDGET. When
  // null, the app computes it live from purchase price / expected sale /
  // costs / reserve / minimum profit (see computeMaxRenovationBudget in
  // calc.ts) rather than storing a stale snapshot.
  maxRenovationBudgetOverride Float?

  incomeTaxPct Float? // 0-1, optional, default 0

  bandWidthPct Float? // width of NORMAL/BUY-NOW bands around the good threshold, default 0.08

  updatedAt DateTime @updatedAt
}

// --- FlatScan Data API integration ---
//
// A global (cross-project) read-through cache so the same FlatScan listing
// is never re-fetched twice within its TTL just because it's relevant to
// two different projects' comparable sets — the Starter tier allows only
// 1 000 calls/month. See src/lib/sources/flatScan/ for the client/provider.
//
// FlatScanRequestLog is the source of truth for "how many real API calls
// have we made" (Provider Health, item 2) — a cache hit never adds a row
// here, only an actual outbound HTTP request does.

model FlatScanListingCache {
  id         String @id @default(cuid())
  flatScanId String @unique // FlatScan's own numeric/string listing id

  portal            String? // "server" in the FlatScan API — the original portal, e.g. "Sreality.cz"
  url               String?
  name              String?
  disposition       String?
  areaM2            Float?
  municipality      String? // "city"
  locality          String?
  latitude          Float?
  longitude         Float?
  priceOriginal     Float?
  priceCurrent      Float?
  pricePerM2        Float? // price.per_meter (original)
  currentPricePerM2 Float? // price.current_per_meter
  onRequest         Boolean @default(false) // price.on_request
  seller            String?
  daysOnMarket      Int?
  discountPercent   Float?
  active            Boolean @default(true)
  sourceCreatedAt   DateTime? // dates.created
  sourceDeletedAt   DateTime? // dates.deleted

  // Comparison-relevant fields the documented example doesn't list but a
  // real listing object may carry (condition, construction, floor,
  // elevator, balcony/terrace, parking, ownership) — read defensively by
  // the mapper if present, left null otherwise. Never guessed.
  condition    String?
  construction String?
  floor        String?
  totalFloors  String?
  elevator     Boolean?
  balcony      Boolean?
  terrace      Boolean?
  loggia       Boolean?
  parking      Boolean?
  ownership    String?

  rawJson String? // full raw API response object, for fields not yet modeled above

  firstSeenAt   DateTime @default(now()) // first time DziFlip ever saw this FlatScan listing
  lastSeenAt    DateTime @default(now()) // last time a live API call re-confirmed it (price/status)
  lastFetchedAt DateTime @default(now()) // cache freshness clock for this row

  priceHistory FlatScanPriceHistoryCache[]
}

model FlatScanPriceHistoryCache {
  id             String               @id @default(cuid())
  listingCacheId String
  listingCache   FlatScanListingCache @relation(fields: [listingCacheId], references: [id], onDelete: Cascade)
  price          Float?
  recordedAt     DateTime
  fetchedAt      DateTime             @default(now())
}

// Caches a whole GET /listings search result (by normalized query
// signature) so an identical/overlapping search from a different project,
// within TTL, reuses the FlatScan id list instead of calling the API again.
model FlatScanSearchCache {
  id             String   @id @default(cuid())
  querySignature String   @unique
  flatScanIds    String // JSON array of FlatScan listing ids
  fetchedAt      DateTime @default(now())
}

// Cached GET /districts, /localities, /stats context — refreshed far less
// often than individual listings since locality-level aggregates move slowly.
model FlatScanLocalityStats {
  id                 String   @id @default(cuid())
  key                String   @unique // normalized "municipality|district"
  municipality       String?
  district           String?
  medianPricePerM2   Float?
  avgPricePerM2      Float?
  activeListingCount Int?
  trendPct           Float? // only set when the API itself reports a trend — never computed/guessed locally
  fetchedAt          DateTime @default(now())
}

// One row per actual outbound FlatScan API request — never per cache hit.
// This is what "počet API volání tento měsíc" in Provider Health counts.
model FlatScanRequestLog {
  id           String   @id @default(cuid())
  endpoint     String // e.g. "GET /listings"
  ok           Boolean
  statusCode   Int?
  errorMessage String?
  requestedAt  DateTime @default(now())
}
