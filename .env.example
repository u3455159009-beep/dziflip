# Local SQLite database (default, works out of the box)
DATABASE_URL="file:./dev.db"

# --- Future integrations (not required for MVP, app works without them) ---
# When set, enables real web search for comparables instead of manual entry.
# SEARCH_API_KEY=

# When set, enables AI photo analysis (room recognition, condition assessment).
# VISION_API_KEY=

# When set, enables AI-generated after-renovation room visualizations.
# IMAGE_GEN_API_KEY=

# When set, enables live product price lookups for the shopping list.
# PRODUCT_SEARCH_API_KEY=

# When both are set, enables real outbound e-mail for viewing-request
# messages (Contact automation). Without them, messages are always
# prepared/logged but never claimed as sent (status BLOCKED_NO_PROVIDER).
# SMTP_HOST=
# SMTP_FROM=

# When set, enables an approved data source for a real estate portal (e.g.
# Sreality.cz) in Deal Radar. Until then that provider stays PENDING_ACCESS
# and is never scraped or bypassed.
# SREALITY_API_KEY=

# When all three are set, enables the REAL_SMS provider (src/lib/sms/realProvider.ts).
# Without them, SMS Hub always uses MOCK_SMS for demo data and safely fails
# (never fakes a send) for real contacts. Adjust the request shape in
# realProvider.ts to match whichever CZ SMS gateway you choose.
# SMS_API_URL=
# SMS_API_KEY=
# SMS_SENDER_ID=

# Optional shared-secret check for the inbound SMS webhook
# (/api/sms/webhook), sent by your SMS provider as an X-Webhook-Secret
# header. Leave unset during local testing.
# SMS_WEBHOOK_SECRET=
